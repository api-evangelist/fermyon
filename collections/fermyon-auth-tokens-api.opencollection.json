{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fermyon Cloud accounts auth-tokens API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "auth-tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "POST /api/auth-tokens",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.fermyon.com/api/auth-tokens",
            "headers": [
              {
                "name": "Api-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "POST /api/auth-tokens/refresh",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.fermyon.com/api/auth-tokens/refresh",
            "headers": [
              {
                "name": "Api-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}