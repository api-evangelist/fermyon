{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fermyon Cloud accounts custom-domains API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "custom-domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/custom-domains/{domainName}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.fermyon.com/api/custom-domains/:domainName",
            "headers": [
              {
                "name": "Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "domainName",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}